# Set these in your shell before npm start. No credentials are required.
HOST=127.0.0.1
PORT=3000
CMUEVENTS_AUTO_REFRESH=1
CMUEVENTS_CONCURRENCY=6
# Enable anonymous rendered-page collection after installing Playwright Chromium.
CMUEVENTS_RENDER_PUBLIC=0
CMUEVENTS_LOG_PROGRESS=0
# CMUEVENTS_BUILD_DATA_DIR=/absolute/path/to/isolated/build-data
# CMUEVENTS_DATA_DIR=/absolute/path/to/local/events-data
