  "implementationFindings": [
    {
      "file": "src/lib/store.mjs",
      "symbol": "occurrenceKeys",
      "finding": "Exact syndicated-copy key requires title length>=20, body>=80 and exact physical venue/body equality; this misses short named activities and harmless provider wrappers."
    },
    {
      "file": "src/lib/store.mjs",
      "symbol": "canonicalUrl",
      "finding": "Current canonicalization covers CampusGroups and tracking parameters but not equivalent LiveWhale /live/events/<id> and /<group>/event/<id> routes."
    },
    {
      "file": "src/lib/store.mjs",
      "symbol": "occurrenceKeys",
      "finding": "UID matching is not publisher-scoped; a generic UID can collide across unrelated providers. Every identity must retain occurrence start and range precision."
    },
    {
      "file": "src/lib/store.mjs",
      "symbol": "mergeEvent",
      "finding": "Provenance is deduplicated only by source.id. This drops distinct eventUrl claims from the same shared calendar. Source attribution and link identity need separate deduplication."
    }
  ],
  "recommendedRules": [
    "Partition candidate matching by exact occurrence start; date-only and timed records need an explicit unique same-local-day enrichment rule and must not bridge multiple clocked sessions.",
    "Strong provider detail identity can canonicalize equivalent routes, scoped to provider origin and event ID, always qualified by occurrence date/time. Feed/viewer/listing URLs are not unique event identities.",
    "For independent copied records require multiple signals: normalized specific title, compatible dates/times, meaningful shared body or published original link, compatible organizer/venue; titles alone are insufficient.",
    "Keep occurrence-level pairwise safeguards during transitive merges; one low-information record must not join incompatible timed or location claims.",
    "Retain every unique (source id, original event URL, source listing URL) claim and expose all links; keep unique department/org facets separately.",
    "Preserve published field conflicts rather than selecting whichever record was processed first or had the longest description.",
    "Official calendar reposts of student-club hosted events remain eligible; deduplication must not become publisher-scope filtering."
  ]
}
